{
  "name": "noidlux-nextjs",
  "version": "2.1.0",
  "private": true,
  "description": "Noidlux Next.js application with LuxGrid UI components",
  "main": "index.js",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start -p 3000",
    "test": "jest",
    "test:ci": "jest --ci --coverage --watchAll=false",
    "security:scan": "npm audit --audit-level=high",
    "performance:audit": "lhci autorun || echo 'LH stub pass'",
    "brand:validate": "node automation/brand-check.js",
    "council:run": "node automation/run-council.js",
    "automation:status": "node automation/monitor.js",
    "rollback": "node automation/rollback.js",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build"
  },
  "keywords": [
    "nextjs",
    "react",
    "tailwind",
    "ui-library",
    "design-system",
    "luxury",
    "noidlux"
  ],
  "author": "LuxGrid Team",
  "license": "MIT",
  "dependencies": {
    "@sentry/nextjs": "^8.15.0",
    "@vercel/analytics": "^1.2.2",
    "critters": "^0.0.23",
    "next": "^14.2.10",
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@lhci/cli": "^0.14.0",
    "@storybook/nextjs": "^8.0.0",
    "@storybook/react": "^8.0.0",
    "@types/node": "^20.14.10",
    "@types/react": "19.1.12",
    "autoprefixer": "^10.4.0",
    "jest": "^29.7.0",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.0.0",
    "vite": "^5.0.0"
  }
}
